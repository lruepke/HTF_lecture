FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


pointSync false;

patches
(
    {
        name inlet;
        patchInfo { type wall; }
        constructFrom set;
        set inletFaceSet;
    }

    {
        name outlet;
        patchInfo { type patch; }
        constructFrom set;
        set outletFaceSet;
    }

    {
        name bottom;
        patchInfo { type symmetryPlane; }
        constructFrom set;
        set bottomFaceSet;
    }

    {
        name top;
        patchInfo { type symmetryPlane; }
        constructFrom set;
        set topFaceSet;
    }
);
